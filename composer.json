{
    "name": "5t/momaapi",
    "description": "Mobility Management Platform",
    "homepage": "https://5t.torino.it",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "auth0/auth0-php": "^7.1",
        "aws/aws-sdk-php": "^3.0",
        "cakephp/authentication": "^2.9",
        "cakephp/authorization": "^2.0",
        "cakephp/cakephp": "4.5.x",
        "cakephp/migrations": "^3.0",
        "cakephp/orm": "^4.5",
        "cakephp/plugin-installer": "^1.3",
        "caseyamcl/toc": "^3.1",
        "erusev/parsedown": "^1.7",
        "erusev/parsedown-extra": "^0.8.1",
        "firebase/php-jwt": "^7.1",
        "friendsofcake/crud": "^6.0",
        "ianw/quickchart": "^1.1",
        "italia/spid-php-lib": "^0.36",
        "josegonzalez/dotenv": "^3.2",
        "jumbojett/openid-connect-php": "^1.0",
        "league/flysystem": "^3.0",
        "league/flysystem-webdav": "^3.0",
        "lorenzo/cakephp-email-queue": "^4.0",
        "mobiledetect/mobiledetectlib": "^2.8",
        "mustache/mustache": "^2.13",
        "paragonie/csp-builder": "^3.0",
        "pda/pheanstalk": "^5.0",
        "phpoffice/phpspreadsheet": "^5.3.0",
        "phpoffice/phpword": "^1",
        "robmorgan/phinx": "^0.12.4",
        "saikiran/geohash": "^1.0",
        "setasign/fpdi": "^2.6",
        "tecnickcom/tcpdf": "^6.10",
        "thadbryson/flysystem-sync": ">=2.0"
    },
    "require-dev": {
        "cakephp/bake": "^2.0",
        "cakephp/cakephp-codesniffer": "^4",
        "cakephp/debug_kit": "^4.1",
        "dereuromark/cakephp-ide-helper": "^1.14",
        "odan/phinx-migrations-generator": "^5.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "~8.5.0",
        "psy/psysh": "@stable",
        "vimeo/psalm": "^4.30"
    },
    "suggest": {
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility.",
        "phpstan/phpstan": "PHPStan focuses on finding errors in your code without actually running it. It catches whole classes of bugs even before you write tests for the code."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Notifications\\": "plugins/Notifications/src/",
            "EmailQueue\\": "plugins/EmailQueue/src/",
            "Reports\\": "plugins/Reports/src/",
            "Orariscuole\\": "plugins/Orariscuole/src/",
            "SecretField\\": "plugins/SecretField/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "Reports\\Test\\": "plugins/Reports/tests/",
            "Orariscuole\\Test\\": "plugins/Orariscuole/tests/",
            "SecretField\\Test\\": "plugins/SecretField/tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall",
            "php bin/generate-version.php"
        ],
        "post-update-cmd": [
            "php bin/generate-version.php"
        ],
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p  src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/",
        "stan": "phpstan analyse src/",
        "test": "phpunit --colors=always"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
