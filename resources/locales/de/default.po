#
# Messaggi di errore / autorizzazione (controllers + authenticator).
# Il msgid è la stringa italiana sorgente passata a __(); i {0}/{1} sono i
# placeholder ICU di CakePHP. Una chiave assente ricade sull'italiano.
#

msgid "Utente non autenticato"
msgstr "Benutzer nicht authentifiziert"

msgid "Utente non autenticato, puoi accedere di nuovo?"
msgstr "Benutzer nicht authentifiziert, können Sie sich erneut anmelden?"

msgid "Utente non autorizzato"
msgstr "Benutzer nicht autorisiert"

msgid "Non sei autorizzato ad accedere alla risorsa richiesta"
msgstr "Sie sind nicht berechtigt, auf die angeforderte Ressource zuzugreifen"

msgid "Utente non attivo"
msgstr "Benutzer nicht aktiv"

msgid "L'utente richiesto non esiste"
msgstr "Der angeforderte Benutzer existiert nicht"

msgid "Token JWT non valido"
msgstr "Ungültiger JWT-Token"

msgid "Token scaduto"
msgstr "Token abgelaufen"

msgid "Token mancante"
msgstr "Token fehlt"

msgid "Errore di validazione"
msgstr "Validierungsfehler"

#
# Messaggi di validazione utente (UsersTable::validationDefault/buildRules):
# mostrati nei form di creazione/modifica utente. Limitato a quelli che possono
# comparire nei flussi di indagine.
#

msgid "Indirizzo email non valido"
msgstr "Ungültige E-Mail-Adresse"

msgid "Email già in uso"
