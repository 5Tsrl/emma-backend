#
# Messaggi di errore / autorizzazione (controllers + authenticator).
# Il msgid è la stringa italiana sorgente passata a __(); i {0}/{1} sono i
# placeholder ICU di CakePHP. Una chiave assente ricade sull'italiano.
#

msgid "Non sei autorizzato ad accedere alla risorsa richiesta"
msgstr "Vous n'êtes pas autorisé à accéder à la ressource demandée"

msgid "Token JWT non valido"
msgstr "Jeton JWT non valide"

msgid "La gestione delle password è disabilitata su questo sito"
msgstr "La gestion des mots de passe est désactivée sur ce site"

msgid "L'utente richiesto non esiste"
msgstr "L'utilisateur demandé n'existe pas"

msgid "Utente non attivo"
msgstr "Utilisateur non actif"

msgid "Utente non autenticato"
msgstr "Utilisateur non authentifié"

msgid "Utente non autenticato, puoi accedere di nuovo?"
msgstr "Utilisateur non authentifié, pouvez-vous vous reconnecter ?"

msgid "Utente non autorizzato"
msgstr "Utilisateur non autorisé"

msgid "Utente e/o password sbagliati: {0}"
msgstr "Utilisateur et/ou mot de passe erronés : {0}"

msgid "Ruolo non valido"
msgstr "Rôle non valide"

msgid "Non sei autorizzato ad assegnare il ruolo admin"
msgstr "Vous n'êtes pas autorisé à attribuer le rôle administrateur"

msgid "Token non valido"
msgstr "Jeton non valide"

msgid "Token non valido, richiedi un nuovo reset della password"
msgstr "Jeton non valide, demandez une nouvelle réinitialisation du mot de passe"

msgid "Token scaduto, richiedi un nuovo reset della password"
msgstr "Jeton expiré, demandez une nouvelle réinitialisation du mot de passe"

msgid "Token mancante"
msgstr "Jeton manquant"

msgid "Token non valido o utente non trovato"
msgstr "Jeton non valide ou utilisateur introuvable"

msgid "Token scaduto"
msgstr "Jeton expiré"

msgid "Impossibile salvare la nuova password"
msgstr "Impossible d'enregistrer le nouveau mot de passe"

msgid "Le password non corrispondono"
msgstr "Les mots de passe ne correspondent pas"

msgid "Nessun utente con la mail: {0}"
msgstr "Aucun utilisateur avec l'e-mail : {0}"

msgid "Impossibile salvare il token per il reset della password"
msgstr "Impossible d'enregistrer le jeton de réinitialisation du mot de passe"

msgid "Impossibile salvare il rinnovo dell'account"
msgstr "Impossible d'enregistrer le renouvellement du compte"

msgid "{0} ERRORE durante la creazione: {1}"
msgstr "{0} ERREUR lors de la création : {1}"

msgid "Errore di validazione"
msgstr "Erreur de validation"

#
# Messaggi di validazione utente (UsersTable::validationDefault/buildRules):
# mostrati nei form di creazione/modifica utente. 'Ruolo non valido' riusa la
# chiave già definita sopra.
#

msgid "Indirizzo email non valido"
msgstr "Adresse e-mail non valide"

msgid "Email già in uso"
msgstr "E-mail déjà utilisée"

msgid "Il Codice Fiscale deve essere di 16 caratteri alfanumerici"
msgstr "Le code fiscal doit comporter 16 caractères alphanumériques"

msgid "Codice Fiscale già in uso"
msgstr "Code fiscal déjà utilisé"

msgid "Ruolo utente obbligatorio"
msgstr "Rôle utilisateur obligatoire"

msgid "Sede {0} non trovata"
msgstr "Siège {0} introuvable"

msgid "L'ufficio {0} non appartiene all'azienda {1}"
msgstr "Le bureau {0} n'appartient pas à l'entreprise {1}"

msgid "Il questionario {0} non esiste"
msgstr "Le questionnaire {0} n'existe pas"

msgid "Il questionario {0} non appartiene all'azienda {1}"
msgstr "Le questionnaire {0} n'appartient pas à l'entreprise {1}"

